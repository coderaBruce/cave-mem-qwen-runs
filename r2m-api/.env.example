# Copy to research1/.env (one level up) and fill in. That file is git-ignored.
#
#   cp r2m-api/.env.example .env
#
# Only OPENAI_API_KEY is required for the baseline reproduction: the backbone,
# the embeddings and (later) the GPT-4o Evaluator all go through it.

OPENAI_API_KEY=sk-...

# Optional: proxy / Azure / compatible gateway. Leave unset for api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: only needed if we run cross-backbone experiments.
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
